# =============================================================================
# Pulse CRM — environment variable reference
# =============================================================================
# Copy this file to `.env.local` and fill in values. Never commit `.env.local`.
#
# Only variables prefixed with NEXT_PUBLIC_ are exposed to the browser. Every
# other variable is server-only.
# =============================================================================


# ---------------------------------------------------------------------------
# Core app
# ---------------------------------------------------------------------------

# The fully-qualified URL used for OAuth callbacks, CSRF origin checks, email
# links, etc. Use http://localhost:3000 in development and your production URL
# on deploy (no trailing slash).
NEXT_PUBLIC_APP_URL="http://localhost:3000"


# ---------------------------------------------------------------------------
# Supabase (required)
# ---------------------------------------------------------------------------

# Public URL of your Supabase project (safe to expose).
NEXT_PUBLIC_SUPABASE_URL="https://<your-project>.supabase.co"

# Anon key — enforced by RLS. Safe to expose.
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Service role key — BYPASSES RLS. NEVER expose to the client. Used by:
#   - background Lead Finder enrichment worker
#   - cron endpoints
#   - admin-scoped server actions
SUPABASE_SERVICE_ROLE_KEY=""


# ---------------------------------------------------------------------------
# Cron + API authentication
# ---------------------------------------------------------------------------

# Shared secret for Vercel cron endpoints. Sent by Vercel as
# `Authorization: Bearer <CRON_SECRET>`; enforced via verifyCronRequest().
CRON_SECRET=""

# Bearer token for the public Pulse CRM API (/api/public/*). Keep secret.
PULSE_CRM_API_KEY=""

# 32-byte (hex) key for encrypting stored refresh tokens and other secrets.
# Generate with:  openssl rand -hex 32
ENCRYPTION_KEY=""


# ---------------------------------------------------------------------------
# Lead Finder — Apify
# ---------------------------------------------------------------------------

# Canonical Apify token. Legacy names APIFY_TOKEN / APIFY_API_KEY still work
# but new deploys should use APIFY_API_TOKEN.
APIFY_API_TOKEN=""


# ---------------------------------------------------------------------------
# Lead Finder — AI providers
# ---------------------------------------------------------------------------
# At least one provider must be configured. Per-tenant keys can also be stored
# in the `ai_settings` table via the Lead Finder settings page; env values are
# used as fallbacks.

ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
OPENROUTER_API_KEY=""
GROQ_API_KEY=""

# Local Ollama server (optional). Default: http://localhost:11434
OLLAMA_BASE_URL="http://localhost:11434"

# Hosted Ollama Cloud key (optional). https://ollama.com
OLLAMA_CLOUD_API_KEY=""

# Server-wide fallback (optional): an Anthropic-compatible endpoint such as
# LLMsRelay, used when a workspace has no AI key of its own. Tried after every
# other key. Needs both the base URL (https only, e.g. https://api.llmsrelay.com)
# and the key; this key is only ever sent to this URL.
CUSTOM_AI_BASE_URL=""
CUSTOM_AI_API_KEY=""
# Models for this endpoint. Defaults: claude-sonnet-4.6 and claude-haiku-4.5
CUSTOM_AI_MODEL=""
CUSTOM_AI_FAST_MODEL=""

# Daily token limits (per UTC day, reset at midnight UTC) for AI calls paid by
# any server-wide key above (ANTHROPIC/OPENAI/OPENROUTER/GROQ, OLLAMA_BASE_URL,
# OLLAMA_CLOUD_API_KEY, CUSTOM_AI_*). Workspaces using their own keys are never
# limited by these. Whole numbers; 0 turns shared AI off.
# Per workspace. Default: 50000
AI_SHARED_ORG_DAILY_TOKEN_LIMIT=""
# All workspaces together. Default: 1000000
AI_SHARED_DAILY_TOKEN_LIMIT=""


# ---------------------------------------------------------------------------
# Lead Finder — Obsidian observations (optional)
# ---------------------------------------------------------------------------
# When unset, Obsidian sync is disabled globally regardless of per-tenant
# settings. This variable MUST be set for Obsidian writes to occur; it
# allowlists the filesystem root under which any tenant-configured vault path
# must resolve. All paths that escape this root are rejected.
OBSIDIAN_ALLOWED_ROOT=""


# ---------------------------------------------------------------------------
# LinkedIn OAuth (optional — for LinkedIn actions and outreach)
# ---------------------------------------------------------------------------
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""


# ---------------------------------------------------------------------------
# Google OAuth (for Gmail sending + sign-in)
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Must match exactly what's configured in the Google Cloud console.
GOOGLE_REDIRECT_URI="http://localhost:3000/api/email/oauth/google/callback"


# ---------------------------------------------------------------------------
# Microsoft OAuth (for Outlook sending + sign-in)
# ---------------------------------------------------------------------------
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_REDIRECT_URI="http://localhost:3000/api/email/oauth/microsoft/callback"


# ---------------------------------------------------------------------------
# WhatsApp Business API (optional — for WhatsApp outreach)
# ---------------------------------------------------------------------------
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""


# ---------------------------------------------------------------------------
# Email webhooks (inbound parsing — optional)
# ---------------------------------------------------------------------------
EMAIL_WEBHOOK_SECRET=""


# ---------------------------------------------------------------------------
# PostPeer social scheduling (optional)
# ---------------------------------------------------------------------------
# Read by lib/postpeer/client.ts; when unset, social scheduling is not connected.
POSTPEER_API_KEY=""
# The one organization (profiles.organization_id) allowed to use the shared PostPeer account; every other tenant gets "Social publishing is not enabled".
POSTPEER_OWNER_ORG_ID=""


# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
# Leave unset in normal Next.js deployments. Automatically set to "nodejs"
# or "edge" by Next. Documented here for reference only.
# NEXT_RUNTIME="nodejs"

# Set automatically by Vercel; used as a fallback app URL in emails if
# NEXT_PUBLIC_APP_URL is missing.
# VERCEL_URL=""


# ---------------------------------------------------------------------------
# Open access (testing phase: no login, every visitor gets a guest workspace)
# ---------------------------------------------------------------------------

# "true" turns on open access. Read at build time, so redeploy after changing.
NEXT_PUBLIC_OPEN_ACCESS=""

# Maximum guest workspaces created per hour across the site. Default: 200
GUEST_SIGNUPS_PER_HOUR=""

# Days before the daily cron deletes an inactive guest workspace. Default: 7
GUEST_RETENTION_DAYS=""

# Set to "false" to create guest workspaces without demo data. Default: seeded
GUEST_SEED_DEMO_DATA=""
